# Copie este archivo a /etc/argos/argos.env y asigne permisos 600 a root:argos.
# Nunca guarde este archivo dentro de un respaldo ni repositorio.
ASPNETCORE_URLS=https://0.0.0.0:7443
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=ARGOS;Username=argos;Password=CAMBIAR
Kestrel__Endpoints__Https__Url=https://0.0.0.0:7443
Kestrel__Endpoints__Https__Certificate__Path=/etc/argos/server.pfx
Kestrel__Endpoints__Https__Certificate__Password=CAMBIAR
Gmail__Sender=CAMBIAR
Gmail__AppPassword=CAMBIAR
