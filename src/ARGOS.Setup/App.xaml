<Application x:Class="ARGOS.Setup.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="Welcome.xaml">
 <Application.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="BorderBrush" Value="#CBDDE1"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="BorderBrush" Value="#CBDDE1"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,8,10,8"/><Setter Property="Background" Value="#087F86"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
 </Application.Resources>
</Application>
