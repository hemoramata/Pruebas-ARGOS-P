<Window x:Class="ARGOS.Setup.Welcome" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ARGOS · Asistente de pruebas" Width="1050" Height="800" MinWidth="850" MinHeight="620" Background="#F0F6F6" Foreground="#143C4B" FontSize="14" WindowStartupLocation="CenterScreen">
 <Grid Margin="28">
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,12,24,0">
   <TextBlock Text="ARGOS" FontSize="32" FontWeight="Bold"/>
   <TextBlock Text="Configuración guiada" FontSize="18" Margin="0,8,0,24"/>
   <TextBlock Text="COPIA DE PRUEBAS" FontWeight="Bold" Foreground="#087F86"/>
   <TextBlock Text="No modifica la base original ni crea un superusuario de los creadores." Margin="0,8,0,24"/>
   <StackPanel x:Name="Steps"/>
   <TextBlock Text="Las claves se introducen aquí, no en comandos ni en el chat." Margin="0,30,0,0"/>
  </StackPanel>
  <Border Grid.Column="1" Background="White" CornerRadius="18" Padding="26">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="TitleText" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="Subtitle" Margin="0,10,0,20"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Body"/></ScrollViewer>
    <TextBlock Grid.Row="2" x:Name="Status" Margin="0,14,0,10" Foreground="#9B3026" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="StopServer" Content="Detener servidor de pruebas" Click="StopClick" Background="#49636D" Visibility="Collapsed"/>
     <Button x:Name="Back" Content="Atrás" Click="BackClick" Background="#49636D"/>
     <Button x:Name="Next" Content="Continuar" Click="NextClick"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
