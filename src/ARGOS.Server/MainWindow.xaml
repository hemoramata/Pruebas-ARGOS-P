<Window x:Class="ARGOS.Server.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ARGOS · Administración del servidor" Width="850" Height="590" MinWidth="700" MinHeight="500" Background="#EFF6F6" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="0,8,12,8"/><Setter Property="Background" Value="#087F86"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="ARGOS · Servidor" FontSize="30" FontWeight="Bold" Foreground="#093D50"/><TextBlock Text="Administración local sin consola ni comandos" Margin="0,8,0,24" FontSize="16"/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="28">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Button x:Name="InstallServerButton" Content="Instalar servidor…" Click="InstallClick" HorizontalAlignment="Left"/>
    <TextBlock Text="Servicio instalado en este equipo" FontWeight="Bold" FontSize="18"/>
    <ComboBox x:Name="Services" Margin="0,16,0,12" Padding="10" SelectionChanged="SelectionChanged" DisplayMemberPath="Display"/>
    <TextBlock x:Name="Status" FontSize="17" Margin="0,6,0,16"/>
    <WrapPanel>
     <Button x:Name="StartButton" Content="Iniciar servidor" Click="StartClick"/>
     <Button x:Name="StopButton" Content="Detener servidor" Click="StopClick"/>
     <Button Content="Actualizar estado" Click="RefreshClick"/>
    </WrapPanel>
    <TextBlock x:Name="Message" Margin="0,12,0,12" Foreground="#6A4040"/>
    <TextBlock Text="Dirección a comprobar (laboratorio local: https://localhost:7443)"/>
    <TextBox x:Name="DiagnosticAddress" Text="https://localhost:7443" Padding="8" Margin="0,6"/>
    <Button x:Name="DiagnosticButton" Content="Comprobar conexión y certificado" Click="DiagnoseClick" HorizontalAlignment="Left"/>
    <TextBlock x:Name="DiagnosticMessage" Margin="0,6,0,12"/>
    <Button Content="Respaldo de base de datos…" Click="BackupClick" HorizontalAlignment="Left"/>
    <Button Content="Programar respaldo diario cifrado…" Click="ScheduleBackupClick" HorizontalAlignment="Left"/>
    <Button Content="Restaurar respaldo cifrado…" Click="RestoreClick" HorizontalAlignment="Left"/>
    <Button x:Name="ElevateButton" Content="Autorizar administración del servidor" Click="ElevateClick" HorizontalAlignment="Left"/>
    <Button Content="Abrir asistente de pruebas existente" Click="OpenAssistant" HorizontalAlignment="Left"/>
   </StackPanel>
   </ScrollViewer>
  </Border>
  <TextBlock Grid.Row="2" Margin="0,20,0,0" Text="Detener un servicio interrumpe conexiones y sesiones. Este panel no modifica la base de datos ni instala servicios automáticamente." Foreground="#526B75"/>
 </Grid>
</Window>
