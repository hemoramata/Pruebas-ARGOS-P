<Window x:Class="ARGOS.Server.ScheduleBackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ARGOS · Respaldo diario" Width="700" Height="720" WindowStartupLocation="CenterOwner" Background="#EFF6F6">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="32"><Border Background="White" CornerRadius="16" Padding="28"><StackPanel x:Name="Fields">
  <TextBlock Text="Respaldo diario cifrado" FontSize="26" FontWeight="Bold" Foreground="#093D50"/>
  <TextBlock Text="Windows ejecutará este respaldo como servicio. La conexión y la clave se guardan cifradas para este equipo; no se muestran ni se piden en cada ejecución." Margin="0,10,0,18" TextWrapping="Wrap"/>
  <TextBlock Text="Nombre del respaldo"/><TextBox x:Name="ScheduleName" Text="ARGOS-Diario" Padding="8" Margin="0,4,0,10"/>
  <TextBlock Text="Hora diaria (formato 24 horas, por ejemplo 21:30)"/><TextBox x:Name="Time" Text="21:30" Padding="8" Margin="0,4,0,10"/>
  <TextBlock Text="Servidor PostgreSQL"/><WrapPanel><TextBox x:Name="Host" Text="localhost" Width="400" Padding="8"/><TextBox x:Name="Port" Text="5432" Width="100" Padding="8" Margin="8,0,0,0"/></WrapPanel>
  <TextBlock Text="Base de datos" Margin="0,10,0,0"/><TextBox x:Name="Database" Padding="8" Margin="0,4,0,10"/>
  <TextBlock Text="Usuario PostgreSQL"/><TextBox x:Name="User" Padding="8" Margin="0,4,0,10"/>
  <TextBlock Text="Contraseña PostgreSQL"/><PasswordBox x:Name="Password" Padding="8" Margin="0,4,0,10"/>
  <TextBlock Text="Carpeta de herramientas PostgreSQL (pg_dump)"/><DockPanel Margin="0,4,0,10"><Button Content="Elegir…" Click="ChooseBin" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Bin" Padding="8"/></DockPanel>
  <TextBlock Text="Carpeta de destino del respaldo"/><DockPanel Margin="0,4,0,10"><Button Content="Elegir…" Click="ChooseDestination" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Destination" Padding="8"/></DockPanel>
  <TextBlock Text="Clave de recuperación (mínimo 12 caracteres)"/><PasswordBox x:Name="RecoveryPassphrase" Padding="8" Margin="0,4,0,10"/>
  <TextBlock Text="Confirme la clave de recuperación"/><PasswordBox x:Name="RecoveryConfirmation" Padding="8" Margin="0,4,0,12"/>
  <CheckBox x:Name="Consent" Content="Entiendo que sin esta clave no podré restaurar el respaldo." Margin="0,0,0,12"/>
  <Button x:Name="CreateButton" Content="Guardar y programar respaldo diario" Click="CreateSchedule" Background="#087F86" Foreground="White" Padding="16,10"/>
  <TextBlock x:Name="Result" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#385D67"/>
 </StackPanel></Border></Grid></ScrollViewer>
</Window>
